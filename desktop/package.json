{
  "name": "yerelai-desktop",
  "version": "13.0.0",
  "description": "YerelAI Studio — Windows Desktop App (Electron + Local Gemma 4 CUDA Engine)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "npx electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0"
  },
  "build": {
    "appId": "com.yerelai.studio",
    "productName": "YerelAI Studio",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "companion.html",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YerelAI Studio"
    }
  }
}
